org.springframework.aot.hint.RuntimeHintsRegistrar=\
io.github.kotlinmania.spring.boot.jackson2.autoconfigure.Jackson2AutoConfiguration$Jackson2AutoConfigurationRuntimeHints

org.springframework.beans.factory.aot.BeanFactoryInitializationAotProcessor=\
io.github.kotlinmania.spring.boot.jackson2.JsonComponentModule$JsonComponentBeanFactoryInitializationAotProcessor

org.springframework.beans.factory.aot.BeanRegistrationAotProcessor=\
io.github.kotlinmania.spring.boot.jackson2.JsonMixinModuleEntriesBeanRegistrationAotProcessor
