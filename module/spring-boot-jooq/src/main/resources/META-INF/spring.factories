io.github.kotlinmania.spring.boot.jooq.autoconfigure.JaxbNotAvailableExceptionFailureAnalyzer,\
io.github.kotlinmania.spring.boot.jooq.autoconfigure.NoDslContextBeanFailureAnalyzer

