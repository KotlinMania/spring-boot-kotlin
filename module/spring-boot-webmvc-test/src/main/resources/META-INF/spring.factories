# Spring Test Context Customizer Factories
org.springframework.test.context.ContextCustomizerFactory=\
io.github.kotlinmania.spring.boot.webmvc.test.autoconfigure.WebDriverContextCustomizerFactory

# Spring Test Execution Listeners
org.springframework.test.context.TestExecutionListener=\
io.github.kotlinmania.spring.boot.webmvc.test.autoconfigure.MockMvcPrintOnlyOnFailureTestExecutionListener,\
io.github.kotlinmania.spring.boot.webmvc.test.autoconfigure.WebDriverTestExecutionListener
