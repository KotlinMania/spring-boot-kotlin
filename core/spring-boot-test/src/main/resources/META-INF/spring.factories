# Spring Test Context Customizer Factories
org.springframework.test.context.ContextCustomizerFactory=\
io.github.kotlinmania.spring.boot.test.context.ImportsContextCustomizerFactory,\
io.github.kotlinmania.spring.boot.test.context.PropertyMappingContextCustomizerFactory,\
io.github.kotlinmania.spring.boot.test.context.filter.ExcludeFilterContextCustomizerFactory,\
io.github.kotlinmania.spring.boot.test.context.filter.annotation.TypeExcludeFiltersContextCustomizerFactory,\
io.github.kotlinmania.spring.boot.test.http.client.DisableReactorResourceFactoryGlobalResourcesContextCustomizerFactory,\
io.github.kotlinmania.spring.boot.test.json.DuplicateJsonObjectContextCustomizerFactory

# Application Context Initializers
org.springframework.context.ApplicationContextInitializer=\
io.github.kotlinmania.spring.boot.test.context.filter.ExcludeFilterApplicationContextInitializer
