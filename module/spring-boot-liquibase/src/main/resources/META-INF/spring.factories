# Connection Details Factories
io.github.kotlinmania.spring.boot.autoconfigure.service.connection.ConnectionDetailsFactory=\
io.github.kotlinmania.spring.boot.liquibase.docker.compose.JdbcAdaptingLiquibaseConnectionDetailsFactory,\
io.github.kotlinmania.spring.boot.liquibase.testcontainers.LiquibaseContainerConnectionDetailsFactory

# Failure Analyzers
io.github.kotlinmania.spring.boot.diagnostics.FailureAnalyzer=\
io.github.kotlinmania.spring.boot.liquibase.LiquibaseChangelogMissingFailureAnalyzer

# Database Initializer Detectors
io.github.kotlinmania.spring.boot.sql.init.dependency.DatabaseInitializerDetector=\
io.github.kotlinmania.spring.boot.liquibase.LiquibaseDatabaseInitializerDetector
