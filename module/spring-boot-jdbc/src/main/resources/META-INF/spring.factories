# Failure Analyzers
io.github.kotlinmania.spring.boot.diagnostics.FailureAnalyzer=\
io.github.kotlinmania.spring.boot.jdbc.autoconfigure.DataSourceBeanCreationFailureAnalyzer,\
io.github.kotlinmania.spring.boot.jdbc.autoconfigure.HikariDriverConfigurationFailureAnalyzer

# Connection Details Factories
io.github.kotlinmania.spring.boot.autoconfigure.service.connection.ConnectionDetailsFactory=\
io.github.kotlinmania.spring.boot.jdbc.docker.compose.ClickHouseJdbcDockerComposeConnectionDetailsFactory,\
io.github.kotlinmania.spring.boot.jdbc.docker.compose.MariaDbJdbcDockerComposeConnectionDetailsFactory,\
io.github.kotlinmania.spring.boot.jdbc.docker.compose.MySqlJdbcDockerComposeConnectionDetailsFactory,\
io.github.kotlinmania.spring.boot.jdbc.docker.compose.OracleFreeJdbcDockerComposeConnectionDetailsFactory,\
io.github.kotlinmania.spring.boot.jdbc.docker.compose.OracleXeJdbcDockerComposeConnectionDetailsFactory,\
io.github.kotlinmania.spring.boot.jdbc.docker.compose.PostgresJdbcDockerComposeConnectionDetailsFactory,\
io.github.kotlinmania.spring.boot.jdbc.docker.compose.SqlServerJdbcDockerComposeConnectionDetailsFactory,\
io.github.kotlinmania.spring.boot.jdbc.testcontainers.JdbcContainerConnectionDetailsFactory

# Database Initializer Detectors
io.github.kotlinmania.spring.boot.sql.init.dependency.DatabaseInitializerDetector=\
io.github.kotlinmania.spring.boot.jdbc.init.DataSourceScriptDatabaseInitializerDetector

# Depends On Database Initialization Detectors
io.github.kotlinmania.spring.boot.sql.init.dependency.DependsOnDatabaseInitializationDetector=\
io.github.kotlinmania.spring.boot.jdbc.SpringJdbcDependsOnDatabaseInitializationDetector
