# Application Context Factories
io.github.kotlinmania.spring.boot.ApplicationContextFactory=\
io.github.kotlinmania.spring.boot.web.server.reactive.context.ReactiveWebServerApplicationContextFactory,\
io.github.kotlinmania.spring.boot.web.server.servlet.context.ServletWebServerApplicationContextFactory

# Application Context Initializers
org.springframework.context.ApplicationContextInitializer=\
io.github.kotlinmania.spring.boot.web.server.context.ServerPortInfoApplicationContextInitializer

# Failure Analyzers
io.github.kotlinmania.spring.boot.diagnostics.FailureAnalyzer=\
io.github.kotlinmania.spring.boot.web.server.PortInUseFailureAnalyzer,\
io.github.kotlinmania.spring.boot.web.server.context.MissingWebServerFactoryBeanFailureAnalyzer

# HTTP Server LocalTestWebServer Providers
io.github.kotlinmania.spring.boot.test.http.server.LocalTestWebServer$Provider=\
io.github.kotlinmania.spring.boot.web.server.reactive.context.ReactiveWebServerApplicationContextLocalTestWebServerProvider,\
io.github.kotlinmania.spring.boot.web.server.servlet.context.ServletWebServerApplicationContextLocalTestWebServerProvider

# Spring Test Context Customizer Factories
org.springframework.test.context.ContextCustomizerFactory=\
io.github.kotlinmania.spring.boot.web.server.context.SpringBootTestRandomPortContextCustomizerFactory

