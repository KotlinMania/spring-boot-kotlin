# ApplicationContext Initializers
org.springframework.context.ApplicationContextInitializer=\
io.github.kotlinmania.spring.boot.devtools.restart.RestartScopeInitializer

# Application Listeners
org.springframework.context.ApplicationListener=\
io.github.kotlinmania.spring.boot.devtools.logger.DevToolsLogFactory$Listener,\
io.github.kotlinmania.spring.boot.devtools.restart.RestartApplicationListener

# Environment Post Processors
io.github.kotlinmania.spring.boot.EnvironmentPostProcessor=\
io.github.kotlinmania.spring.boot.devtools.env.DevToolsHomePropertiesPostProcessor,\
io.github.kotlinmania.spring.boot.devtools.env.DevToolsPropertyDefaultsPostProcessor
