io.github.kotlinmania.spring.boot.r2dbc.docker.compose.MariaDbR2dbcDockerComposeConnectionDetailsFactory,\
io.github.kotlinmania.spring.boot.r2dbc.docker.compose.MySqlR2dbcDockerComposeConnectionDetailsFactory,\
io.github.kotlinmania.spring.boot.r2dbc.docker.compose.OracleFreeR2dbcDockerComposeConnectionDetailsFactory,\
io.github.kotlinmania.spring.boot.r2dbc.docker.compose.OracleXeR2dbcDockerComposeConnectionDetailsFactory,\
io.github.kotlinmania.spring.boot.r2dbc.docker.compose.PostgresR2dbcDockerComposeConnectionDetailsFactory,\
io.github.kotlinmania.spring.boot.r2dbc.docker.compose.SqlServerR2dbcDockerComposeConnectionDetailsFactory,\
io.github.kotlinmania.spring.boot.r2dbc.testcontainers.ClickHouseR2dbcContainerConnectionDetailsFactory,\
io.github.kotlinmania.spring.boot.r2dbc.testcontainers.DeprecatedMariaDbR2dbcContainerConnectionDetailsFactory,\
io.github.kotlinmania.spring.boot.r2dbc.testcontainers.DeprecatedMySqlR2dbcContainerConnectionDetailsFactory,\
io.github.kotlinmania.spring.boot.r2dbc.testcontainers.DeprecatedPostgresR2dbcContainerConnectionDetailsFactory,\
io.github.kotlinmania.spring.boot.r2dbc.testcontainers.DeprecatedSqlServerR2dbcContainerConnectionDetailsFactory,\
io.github.kotlinmania.spring.boot.r2dbc.testcontainers.MariaDbR2dbcContainerConnectionDetailsFactory,\
io.github.kotlinmania.spring.boot.r2dbc.testcontainers.MySqlR2dbcContainerConnectionDetailsFactory,\
io.github.kotlinmania.spring.boot.r2dbc.testcontainers.OracleFreeR2dbcContainerConnectionDetailsFactory,\
io.github.kotlinmania.spring.boot.r2dbc.testcontainers.OracleXeR2dbcContainerConnectionDetailsFactory,\
io.github.kotlinmania.spring.boot.r2dbc.testcontainers.PostgresR2dbcContainerConnectionDetailsFactory,\
io.github.kotlinmania.spring.boot.r2dbc.testcontainers.SqlServerR2dbcContainerConnectionDetailsFactory





# Database Initializer Detectors
io.github.kotlinmania.spring.boot.sql.init.dependency.DatabaseInitializerDetector=\
io.github.kotlinmania.spring.boot.r2dbc.init.R2dbcScriptDatabaseInitializerDetector

# Failure Analyzers
io.github.kotlinmania.spring.boot.diagnostics.FailureAnalyzer=\
io.github.kotlinmania.spring.boot.r2dbc.autoconfigure.ConnectionFactoryBeanCreationFailureAnalyzer,\
io.github.kotlinmania.spring.boot.r2dbc.autoconfigure.MissingR2dbcPoolDependencyFailureAnalyzer,\
io.github.kotlinmania.spring.boot.r2dbc.autoconfigure.MultipleConnectionPoolConfigurationsFailureAnalyzer,\
io.github.kotlinmania.spring.boot.r2dbc.autoconfigure.NoConnectionFactoryBeanFailureAnalyzer
