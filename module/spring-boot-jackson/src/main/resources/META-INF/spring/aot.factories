org.springframework.aot.hint.RuntimeHintsRegistrar=\
io.github.kotlinmania.spring.boot.jackson.autoconfigure.JacksonAutoConfiguration$JacksonAutoConfigurationRuntimeHints

org.springframework.beans.factory.aot.BeanFactoryInitializationAotProcessor=\
io.github.kotlinmania.spring.boot.jackson.JacksonComponentModule$JacksonComponentBeanFactoryInitializationAotProcessor

org.springframework.beans.factory.aot.BeanRegistrationAotProcessor=\
io.github.kotlinmania.spring.boot.jackson.JacksonMixinModuleEntriesBeanRegistrationAotProcessor
