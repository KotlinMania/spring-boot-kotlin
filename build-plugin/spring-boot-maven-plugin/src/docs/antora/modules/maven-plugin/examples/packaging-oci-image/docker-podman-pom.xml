<?xml version="1.0" encoding="UTF-8"?>
<!-- tag::docker-podman[] -->
<project>
	<build>
		<plugins>
			<plugin>
				<groupId>io.github.kotlinmania.spring.boot./groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<docker>
						<host>unix:///run/user/1000/podman/podman.sock</host>
						<bindHostToBuilder>true</bindHostToBuilder>
					</docker>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
<!-- end::docker-podman[] -->

